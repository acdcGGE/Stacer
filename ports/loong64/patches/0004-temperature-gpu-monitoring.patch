+    const double clk = im->getGpuClock();
+    mLblGpuClock->setText(clk >= 0 ? QString::asprintf("%.0f MHz", clk) : tr("N/A"));
+
+    const double mclk = im->getGpuMemClock();
+    mLblGpuMemClock->setText(mclk >= 0 ? QString::asprintf("%.0f MHz", mclk) : tr("N/A"));
+}
