+QString SystemInfo::getGpuModel() const
+{
+    const QString unknown(QObject::tr("Unknown"));
+    QStringList models;
+
+    QDir drmDir("/sys/class/drm");
+    if (drmDir.exists()) {
+        // only the cardN entries (skip connector suffixes like card0-DP-1)
+        for (const QString &card : drmDir.entryList(QDir::Dirs | QDir::NoDotAndDotDot)) {
+            if (!QRegularExpression("^card\\d+$").match(card).hasMatch())
+                continue;
+            const QString ueventPath = drmDir.absoluteFilePath(card + "/device/uevent");
+            if (!QFile::exists(ueventPath))
+                continue;
+            const QString ueventContent = FileUtil::readStringFromFile(ueventPath);
+            if (!ueventContent.contains("DRIVER="))
+                continue;
+
+            QString model;
+
+            // Preferred: lspci for a human-readable name
+            QRegularExpression slotRe("PCI_SLOT_NAME=([0-9a-fA-F:.]+)");
+            const QRegularExpressionMatch slotM = slotRe.match(ueventContent);
+            const QString slot = slotM.hasMatch() ? slotM.captured(1) : QString();
+            if (!slot.isEmpty() && CommandUtil::isExecutable("lspci")) {
+                try {
+                    const QString out = CommandUtil::exec("lspci", { "-mm", "-s", slot });
+                    QRegularExpressionMatchIterator it = QRegularExpression("\"([^\"]*)\"").globalMatch(out);
+                    QStringList fields;
+                    while (it.hasNext())
+                        fields << it.next().captured(1);
+                    // fields[0]=class, [1]=vendor, [2]=device
+                    if (fields.size() >= 3) {
+                        const QString dev = fields.at(2).trimmed();
+                        if (!dev.isEmpty() && !dev.startsWith("Device "))
+                            model = dev;
+                    }
+                } catch (...) {
+                    model.clear();
+                }
+            }
+
+            // Fallback: build a name from the PCI vendor/device ids
+            if (model.isEmpty()) {
+                QRegularExpression idRe("PCI_ID=([0-9a-fA-F]+):([0-9a-fA-F]+)");
+                const QRegularExpressionMatch idM = idRe.match(ueventContent);
+                if (idM.hasMatch()) {
+                    static const QMap<QString, QString> vendors = {
+                        { "1002", "AMD/ATI" }, { "10de", "NVIDIA" }, { "8086", "Intel" },
+                        { "1a03", "ASPEED" },  { "102b", "Matrox" }
+                    };
+                    const QString vid = idM.captured(1).toLower();
+                    const QString did = idM.captured(2).toLower();
+                    model = QString("%1 0x%2").arg(vendors.value(vid, "0x" + vid)).arg(did);
+                }
+            }
+
+            if (!model.isEmpty() && !models.contains(model))
+                models << model;
+        }
+    }
+
+    return models.isEmpty() ? unknown : models.join(" / ");
+}
+
+QString SystemInfo::getMotherboardModel() const
+{
+    const QString unknown(QObject::tr("Unknown"));
+
+    auto readDmi = [](const QString &file) -> QString {
+        const QString path = "/sys/class/dmi/id/" + file;
+        if (!QFile::exists(path))
+            return QString();
+        QString val = FileUtil::readStringFromFile(path).trimmed();
+        // Drop the usual placeholder values firmware leaves behind
+        if (val.compare("To Be Filled By O.E.M", Qt::CaseInsensitive) == 0 ||
+            val.compare("System Product Name", Qt::CaseInsensitive) == 0 ||
+            val.compare("Default string", Qt::CaseInsensitive) == 0 ||
+            val.isEmpty())
+            return QString();
+        return val;
+    };
+
+    const QString vendor = readDmi("board_vendor");
+    const QString name = readDmi("board_name");
+    QString model = (vendor + " " + name).trimmed();
+
+    // Fall back to the system product identity if the board fields are missing
+    if (model.isEmpty()) {
+        const QString sysVendor = readDmi("sys_vendor");
+        const QString product = readDmi("product_name");
+        model = (sysVendor + " " + product).trimmed();
+    }
+
+    return model.isEmpty() ? unknown : model;
+}
