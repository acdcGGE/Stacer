@@ -0,0 +1,65 @@
+#ifndef SENSORINFO_H
+#define SENSORINFO_H
+
+#include <QElapsedTimer>
+#include <QList>
+#include <QString>
+
+#include "Utils/file_util.h"
+#include "Utils/command_util.h"
+#include "stacer-core_global.h"
+
+// A single temperature reading from any sensor source.
+struct TempReading {
+    QString type;   // "cpu" | "gpu" | "disk" | "other"
+    QString label;  // human readable, e.g. "CPU 0 Temperature" or "/dev/sda"
+    QString source; // hwmon chip name, or "smartctl"
+    double temp;    // degrees Celsius
+
+    TempReading() : temp(-1) {}
+    TempReading(const QString &t, const QString &l, const QString &s, double v)
+        : type(t), label(l), source(s), temp(v) {}
+};
+
+class STACERCORESHARED_EXPORT SensorInfo
+{
+  public:
+    // Every temperature sensor discovered in /sys/class/hwmon.
+    QList<TempReading> getHwmonTemperatures() const;
+
+    // Convenience accessors (best reading of each kind, °C, -1 if unknown).
+    double getCpuTemp() const;
+    double getGpuTemp() const;
+    QList<TempReading> getDiskTemperatures() const;
+
+    // GPU utilization percent (0..100). -1 when not available on this driver.
+    double getGpuUsage() const;
+    // GPU core clock in MHz. -1 when not available.
+    double getGpuClock() const;
+    // GPU memory (VRAM) clock in MHz. -1 when not available.
+    double getGpuMemClock() const;
+
+    // VRAM usage in bytes. 0 when not available on this driver.
+    quint64 getGpuMemoryUsed() const;
+    quint64 getGpuMemoryTotal() const;
+
+  private:
+    QList<TempReading> parseHwmon() const;
+    double gpuUsageAmdgpu() const;
+    double gpuUsageFdinfo() const;
+    bool sampleEngineNs(quint64 &ns) const;
+    double gpuUsageNvidia() const;
+    double gpuUsageRadeontop() const;
+    // Fill used/total (bytes) from the first GPU that reports them.
+    bool gpuMemoryAmdgpu(quint64 &used, quint64 &total) const;
+    bool gpuMemoryNvidia(quint64 &used, quint64 &total) const;
+    QList<QString> diskDevices() const;
+
+    mutable QElapsedTimer mFdinfoClock;
+    mutable bool mFdinfoSeeded = false;
+    mutable qint64 mFdinfoLastMs = 0;
+    mutable quint64 mFdinfoLastNs = 0;
+    mutable double mFdinfoLastUsage = -1;
+};
+
+#endif // SENSORINFO_H
