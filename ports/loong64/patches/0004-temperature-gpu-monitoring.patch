+void ResourcesPage::updateGpuChart()
+{
+    static int second = 0;
+
+    const double usage = im->getGpuUsage();
+    const int p = usage >= 0 ? qRound(usage) : 0;
+
+    QVector<QSplineSeries *> seriesList = mChartGpu->getSeriesList();
+    QSplineSeries *s = seriesList.at(0);
+
+    for (int i = 0; i < (second < 61 ? second : 61); i++)
+        s->replace(i, (i + 1), s->at(i).y());
+
+    s->insert(0, QPointF(0, p));
+    s->setName(usage >= 0 ? QString("GPU: %1%").arg(p) : QString("GPU: N/A"));
+
+    if (second > 61)
+        s->removePoints(61, 1);
+
+    mChartGpu->setSeriesList(seriesList);
+
+    second++;
+}
