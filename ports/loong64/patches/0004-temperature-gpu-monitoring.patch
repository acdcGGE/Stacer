index 0000000..613f94f
--- /dev/null
+++ b/stacer-core/Info/sensor_info.cpp
@@ -0,0 +1,476 @@
+#include "sensor_info.h"
+
+#include <QDir>
+#include <QFile>
+#include <QRegularExpression>
+#include <QSet>
+#include <QThread>
+
+static QString readSys(const QString &path)
+{
+    return FileUtil::readStringFromFile(path).trimmed();
+}
+
+// Walk every hwmon chip and collect its temperature inputs, classifying each
+// sensor as cpu / gpu / disk / other from the chip name and the temp label.
+QList<TempReading> SensorInfo::parseHwmon() const
+{
+    QList<TempReading> out;
+
+    QDir hwmonDir("/sys/class/hwmon");
+    const QStringList hwmons = hwmonDir.entryList(
+        QStringList() << "hwmon*",
+        QDir::Dirs | QDir::System | QDir::NoDotAndDotDot);
+
+    for (const QString &h : hwmons) {
+        const QString base = "/sys/class/hwmon/" + h;
+        const QString name = readSys(base + "/name").toLower();
+
+        QDir d(base);
+        const QStringList temps = d.entryList(QStringList() << "temp*_input",
+                                              QDir::Files | QDir::System);
+        for (const QString &t : temps) {
+            bool ok = false;
+            const double milli = readSys(base + "/" + t).toDouble(&ok);
+            if (!ok)
+                continue;
+
+            const double c = milli / 1000.0;
+            QString idx = t;
+            idx.remove("temp").remove("_input");
+            const QString label = readSys(base + "/temp" + idx + "_label").toLower();
+
+            QString type = "other";
+            if (name.contains("coretemp") || name.contains("cpu_hwmon") ||
+                name.contains("k10temp") || name.contains("zenpower") ||
+                name.startsWith("cpu")) {
+                type = "cpu";
+            } else if (name.contains("radeon") || name.contains("amdgpu") ||
+                       name.contains("nouveau") || name.contains("nvidia")) {
+                type = "gpu";
+            } else if (name.startsWith("nvme") || name.contains("drivetemp") ||
+                       name.contains("atakb")) {
+                type = "disk";
+            } else {
+                // No helpful chip name: fall back to the sensor label.
+                if (label.contains("cpu") || label.contains("package") || label.contains("core"))
+                    type = "cpu";
+                else if (label.contains("gpu") || label.contains("edge") ||
+                         label.contains("junction") || label.contains("mem"))
+                    type = "gpu";
+                else if (label.contains("nvme") || label.contains("ssd") ||
+                         label.contains("hdd") || label.contains("disk"))
+                    type = "disk";
+            }
+
+            const QString display = label.isEmpty() ? (name + " " + t) : label;
+            out << TempReading(type, display, name, c);
+        }
+    }
+
+    return out;
+}
+
+QList<TempReading> SensorInfo::getHwmonTemperatures() const
+{
+    return parseHwmon();
+}
+
+double SensorInfo::getCpuTemp() const
+{
+    double best = -1;
+    for (const TempReading &r : parseHwmon())
+        if (r.type == "cpu" && r.temp > best)
+            best = r.temp;
+    return best;
+}
+
+double SensorInfo::getGpuTemp() const
+{
+    double best = -1;
+    for (const TempReading &r : parseHwmon())
+        if (r.type == "gpu" && r.temp > best)
+            best = r.temp;
+    return best;
+}
+
+// Whole-disk block devices we can query with smartctl.
+QList<QString> SensorInfo::diskDevices() const
+{
+    QList<QString> devs;
+    QStringList all;
+    try {
+        all = CommandUtil::exec("bash", { "-c", "ls -1 /dev" }).split('\n', Qt::SkipEmptyParts);
+    } catch (...) {
+        return devs;
+    }
+
+    const QRegularExpression re("^(sd[a-z]|hd[a-z]|vd[a-z]|nvme\\d+(n\\d+)?)$");
+    for (const QString &e : all)
+        if (re.match(e).hasMatch())
+            devs << "/dev/" + e;
+    return devs;
+}
+
+QList<TempReading> SensorInfo::getDiskTemperatures() const
+{
+    QList<TempReading> out;
+    if (!CommandUtil::isExecutable("smartctl"))
+        return out;
+
+    for (const QString &dev : diskDevices()) {
+        QString txt;
+        try {
+            txt = CommandUtil::exec("smartctl", { "-A", dev });
+        } catch (...) {
+            continue;
+        }
+        if (txt.isEmpty() ||
+            txt.contains("Permission denied", Qt::CaseInsensitive) ||
+            txt.contains("failed", Qt::CaseInsensitive))
+            continue;
+
+        const QStringList lines = txt.split('\n');
+        for (const QString &line : lines) {
+            const QString l = line.trimmed();
+            if (!l.contains("Temperature", Qt::CaseInsensitive))
+                continue;
+
+            // Collect every integer on the line; pick the temperature value.
+            const QRegularExpression intRe("(-?\\d+)");
+            QList<int> nums;
+            QRegularExpressionMatchIterator it = intRe.globalMatch(l);
+            while (it.hasNext())
+                nums << it.next().captured(0).toInt();
+            if (nums.isEmpty())
+                continue;
+
+            // SATA: "... Temperature_Celsius ... <raw>" -> take last integer.
+            // NVMe: "Temperature: 40 Celsius" -> take first integer.
+            const int temp = (l.contains("Temperature_Celsius", Qt::CaseInsensitive) ||
+                              l.contains("Airflow_Temperature", Qt::CaseInsensitive))
+                                 ? nums.last()
+                                 : nums.first();
+
+            if (temp >= -100 && temp <= 150) {
+                out << TempReading("disk", dev, "smartctl", temp);
+                break; // one temperature per disk is enough
+            }
+        }
+    }
+    return out;
+}
+
+double SensorInfo::getGpuUsage() const
+{
+    double v = gpuUsageAmdgpu();
+    if (v >= 0) return v;
+    v = gpuUsageFdinfo();
+    if (v >= 0) return v;
+    v = gpuUsageNvidia();
+    if (v >= 0) return v;
+    v = gpuUsageRadeontop();
+    return v;
+}
+
+// amdgpu exposes gpu_busy_percent; works for the amdgpu driver only.
+double SensorInfo::gpuUsageAmdgpu() const
+{
+    QDir hwmonDir("/sys/class/hwmon");
+    for (const QString &h : hwmonDir.entryList(
+             QStringList() << "hwmon*", QDir::Dirs | QDir::System | QDir::NoDotAndDotDot)) {
+        const QString base = "/sys/class/hwmon/" + h;
+        const QString name = readSys(base + "/name").toLower();
+        if (name.contains("amdgpu")) {
+            bool ok = false;
+            const double v = readSys(base + "/gpu_busy_percent").toDouble(&ok);
+            if (ok && v >= 0 && v <= 100)
+                return v;
+        }
+    }
+
+    QDir drm("/sys/class/drm");
+    for (const QString &c : drm.entryList(
+             QStringList() << "card*", QDir::Dirs | QDir::System | QDir::NoDotAndDotDot)) {
+        const QString dev = "/sys/class/drm/" + c + "/device";
+        const QString uevent = readSys(dev + "/uevent");
+        if (uevent.contains("DRIVER=amdgpu")) {
+            bool ok = false;
+            const double v = readSys(dev + "/gpu_busy_percent").toDouble(&ok);
+            if (ok && v >= 0 && v <= 100)
+                return v;
+        }
+    }
+    return -1;
+}
+
+// SI-era amdgpu answers EOPNOTSUPP for gpu_busy_percent, but per-context
+// engine time is exposed in fdinfo; diff successive samples for load.
+// Only clients whose fdinfo we may read (same user) are counted.
+double SensorInfo::gpuUsageFdinfo() const
+{
+    quint64 ns = 0;
+    if (!sampleEngineNs(ns))
+        return -1;
+    if (!mFdinfoClock.isValid())
+        mFdinfoClock.start();
+    const qint64 now = mFdinfoClock.elapsed();
+    if (!mFdinfoSeeded) {
+        QThread::msleep(100);
+        quint64 ns2 = ns;
+        sampleEngineNs(ns2);
+        const qint64 now2 = mFdinfoClock.elapsed();
+        if (now2 > now && ns2 >= ns)
+            mFdinfoLastUsage = qBound(0.0, double(ns2 - ns) / (double(now2 - now) * 1e6) * 100.0, 100.0);
+        mFdinfoLastNs = ns2;
+        mFdinfoLastMs = now2;
+        mFdinfoSeeded = true;
+        return mFdinfoLastUsage;
+    }
+    const qint64 dt = now - mFdinfoLastMs;
+    if (dt > 0 && ns >= mFdinfoLastNs)
+        mFdinfoLastUsage = qBound(0.0, double(ns - mFdinfoLastNs) / (double(dt) * 1e6) * 100.0, 100.0);
+    mFdinfoLastNs = ns;
+    mFdinfoLastMs = now;
+    return mFdinfoLastUsage;
+}
+
+bool SensorInfo::sampleEngineNs(quint64 &ns) const
+{
+    ns = 0;
+    bool found = false;
+    // dup'd fds share one drm_file; count each client only once.
+    QSet<quint64> seenClients;
+    QDir proc("/proc");
+    const QStringList pids = proc.entryList(
+        QStringList() << "[0-9]*", QDir::Dirs | QDir::NoDotAndDotDot);
+    for (const QString &pid : pids) {
+        const QString fdBase = "/proc/" + pid + "/fd";
+        QDir fdDir(fdBase);
+        const QStringList fds = fdDir.entryList(
+            QDir::Files | QDir::System | QDir::NoDotAndDotDot);
+        for (const QString &fd : fds) {
+            if (!QFile::symLinkTarget(fdBase + "/" + fd).startsWith("/dev/dri/"))
+                continue;
+            const QString info =
+                FileUtil::readStringFromFile("/proc/" + pid + "/fdinfo/" + fd);
+            bool amd = false, hasEngine = false;
+            quint64 sum = 0, client = 0;
+            const QStringList lines = info.split('\n');
+            for (const QString &line : lines) {
+                if (line.startsWith("drm-driver:")) {
+                    amd = line.section(':', 1).trimmed() == "amdgpu";
+                } else if (line.startsWith("drm-client-id:")) {
+                    client = line.section(':', 1).trimmed().toULongLong();
+                } else if (line.startsWith("drm-engine-gfx:") ||
+                           line.startsWith("drm-engine-compute:")) {
+                    sum += line.section(':', 1).trimmed().remove(" ns").toULongLong();
+                    hasEngine = true;
+                }
+            }
+            if (amd && hasEngine && !seenClients.contains(client)) {
+                seenClients.insert(client);
+                ns += sum;
+                found = true;
+            }
+        }
+    }
+    return found;
+}
+
+double SensorInfo::gpuUsageNvidia() const
+{
+    if (!CommandUtil::isExecutable("nvidia-smi"))
+        return -1;
+    QString outp;
+    try {
+        outp = CommandUtil::exec("nvidia-smi",
+            { "--query-gpu=utilization.gpu", "--format=csv,noheader,nounits" });
+    } catch (...) {
+        return -1;
+    }
+    bool ok = false;
+    const double v = outp.trimmed().toDouble(&ok);
+    return (ok && v >= 0 && v <= 100) ? v : -1;
+}
+
+// radeontop can report usage for the older radeon driver, but needs root
+// (it reads the GPU registers via /dev/mem) and may not be installed.
+double SensorInfo::gpuUsageRadeontop() const
+{
+    if (!CommandUtil::isExecutable("radeontop"))
+        return -1;
+    QString outp;
+    try {
+        outp = CommandUtil::exec("bash", { "-c", "radeontop -d - -l 1 2>/dev/null" });
+    } catch (...) {
+        return -1;
+    }
+    const QRegularExpression re("gpu\\s+([0-9]+\\.?[0-9]*)%");
+    const QRegularExpressionMatch m = re.match(outp);
+    if (m.hasMatch()) {
+        bool ok = false;
+        const double v = m.captured(1).toDouble(&ok);
+        if (ok && v >= 0 && v <= 100)
+            return v;
+    }
+    return -1;
+}
+
+// amdgpu exposes mem_info_vram_used/_total under the card's PCI device dir.
+bool SensorInfo::gpuMemoryAmdgpu(quint64 &used, quint64 &total) const
+{
+    QDir drm("/sys/class/drm");
+    const QStringList cards = drm.entryList(
+        QStringList() << "card*",
+        QDir::Dirs | QDir::System | QDir::NoDotAndDotDot);
+    // Prefer render-capable real cards (card0), skip card1-N connectors.
+    for (int i = 0; i < 8; ++i) {
+        const QString dev = QString("/sys/class/drm/card%1/device").arg(i);
+        const QString uevent = readSys(dev + "/uevent");
+        if (!uevent.contains("DRIVER=amdgpu"))
+            continue;
+
+        bool uOk = false, tOk = false;
+        const quint64 u = readSys(dev + "/mem_info_vram_used").toULongLong(&uOk);
+        const quint64 t = readSys(dev + "/mem_info_vram_total").toULongLong(&tOk);
+        if (uOk && tOk && t > 0) {
+            used = u;
+            total = t;
+            return true;
+        }
+    }
+    Q_UNUSED(cards);
+    return false;
+}
+
+// nvidia-smi reports MiB; convert to bytes.
+bool SensorInfo::gpuMemoryNvidia(quint64 &used, quint64 &total) const
+{
+    if (!CommandUtil::isExecutable("nvidia-smi"))
+        return false;
+    QString outp;
+    try {
+        outp = CommandUtil::exec("nvidia-smi",
+            { "--query-gpu=memory.used,memory.total", "--format=csv,noheader,nounits" });
+    } catch (...) {
+        return false;
+    }
+    const QRegularExpression re("(\\d+)\\s*,\\s*(\\d+)");
+    const QRegularExpressionMatch m = re.match(outp);
+    if (!m.hasMatch())
+        return false;
+    const quint64 uMiB = m.captured(1).toULongLong();
+    const quint64 tMiB = m.captured(2).toULongLong();
+    if (tMiB == 0)
+        return false;
+    used = uMiB * 1048576ULL;
+    total = tMiB * 1048576ULL;
+    return true;
+}
+
+quint64 SensorInfo::getGpuMemoryUsed() const
+{
+    quint64 used = 0, total = 0;
+    if (gpuMemoryAmdgpu(used, total) || gpuMemoryNvidia(used, total))
+        return used;
+    return 0;
+}
+
+quint64 SensorInfo::getGpuMemoryTotal() const
+{
+    quint64 used = 0, total = 0;
+    if (gpuMemoryAmdgpu(used, total) || gpuMemoryNvidia(used, total))
+        return total;
+    return 0;
+}
+
+double SensorInfo::getGpuClock() const
+{
+    QDir hwmonDir("/sys/class/hwmon");
+    for (const QString &h : hwmonDir.entryList(
+             QStringList() << "hwmon*", QDir::Dirs | QDir::System | QDir::NoDotAndDotDot)) {
+        const QString base = "/sys/class/hwmon/" + h;
+        const QString name = readSys(base + "/name").toLower();
+        if (name.contains("radeon") || name.contains("amdgpu") ||
+            name.contains("nouveau") || name.contains("nvidia")) {
+            QDir d(base);
+            const QStringList freqs = d.entryList(QStringList() << "freq*_input",
+                                                  QDir::Files | QDir::System);
+            for (const QString &f : freqs) {
+                bool ok = false;
+                const double hz = readSys(base + "/" + f).toDouble(&ok);
+                if (ok && hz > 0)
+                    // radeon reports Hz, amdgpu reports kHz; normalise both to MHz.
+                    return (hz > 1e7) ? hz / 1e6 : hz / 1e3;
+            }
+        }
+    }
+
+    if (CommandUtil::isExecutable("nvidia-smi")) {
+        try {
+            const QString outp = CommandUtil::exec("nvidia-smi",
+                { "--query-gpu=clocks.current.graphics", "--format=csv,noheader,nounits" });
+            bool ok = false;
+            const double v = outp.trimmed().toDouble(&ok);
+            if (ok && v > 0)
+                return v;
+        } catch (...) {
+        }
+    }
+    return -1;
+}
+
+double SensorInfo::getGpuMemClock() const
+{
+    QDir hwmonDir("/sys/class/hwmon");
+    for (const QString &h : hwmonDir.entryList(
+             QStringList() << "hwmon*", QDir::Dirs | QDir::System | QDir::NoDotAndDotDot)) {
+        const QString base = "/sys/class/hwmon/" + h;
+        const QString name = readSys(base + "/name").toLower();
+        if (name.contains("radeon") || name.contains("amdgpu") ||
+            name.contains("nouveau") || name.contains("nvidia")) {
+            QDir d(base);
+            const QStringList freqs = d.entryList(QStringList() << "freq*_input",
+                                                  QDir::Files | QDir::System);
+            for (const QString &f : freqs) {
+                QString idx = f;
+                idx.remove("freq").remove("_input");
+                if (readSys(base + "/freq" + idx + "_label").toLower() != "mclk")
+                    continue;
+                bool ok = false;
+                const double hz = readSys(base + "/" + f).toDouble(&ok);
+                if (ok && hz > 0)
+                    // radeon reports Hz, amdgpu reports kHz; normalise both to MHz.
+                    return (hz > 1e7) ? hz / 1e6 : hz / 1e3;
+            }
+        }
+    }
+
+    // Legacy DPM (SI) sysfs: the '*' line is the current level, in MHz.
+    const QRegularExpression re("(\\d+)");
+    for (int i = 0; i < 8; ++i) {
+        const QString dev = QString("/sys/class/drm/card%1/device").arg(i);
+        const QStringList lines = readSys(dev + "/pp_dpm_mclk").split('\n');
+        for (const QString &line : lines) {
+            if (!line.contains('*'))
+                continue;
+            const QRegularExpressionMatch m = re.match(line);
+            if (m.hasMatch() && m.captured(1).toDouble() > 0)
+                return m.captured(1).toDouble();
+        }
+    }
+
+    if (CommandUtil::isExecutable("nvidia-smi")) {
+        try {
+            const QString outp = CommandUtil::exec("nvidia-smi",
+                { "--query-gpu=clocks.current.memory", "--format=csv,noheader,nounits" });
+            bool ok = false;
+            const double v = outp.trimmed().toDouble(&ok);
+            if (ok && v > 0)
+                return v;
+        } catch (...) {
+        }
+    }
+    return -1;
+}
diff --git a/stacer-core/Info/sensor_info.h b/stacer-core/Info/sensor_info.h
