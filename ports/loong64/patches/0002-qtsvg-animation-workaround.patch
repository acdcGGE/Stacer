diff --git a/stacer/Pages/Helpers/svg_loader_compat.h b/stacer/Pages/Helpers/svg_loader_compat.h
new file mode 100644
index 0000000..0a4e83c
--- /dev/null
+++ b/stacer/Pages/Helpers/svg_loader_compat.h
@@ -0,0 +1,31 @@
+#ifndef SVG_LOADER_COMPAT_H
+#define SVG_LOADER_COMPAT_H
+
+#include <QSvgRenderer>
+#include <QtGlobal>
+
+// Qt 6.8.0's animated QSvgRenderer corrupts the heap on loong64:
+//   QSvgTransformStyle::apply -> QArrayData::reallocateUnaligned -> abort
+//   ("realloc(): invalid pointer")
+// Stacer's loader artwork uses animated SVG (animateTransform). Qt 6.8.x is
+// the only version where the crash was reproduced; upstream CI on Qt 6.11
+// does not hit it. Keep animation enabled on newer Qt so other distros do
+// not silently lose the feature.
+//
+// Overrides (via -DCMAKE_CXX_FLAGS):
+//   -DSTACER_ENABLE_SVG_ANIMATION   force 60 fps animation on any Qt >= 6.8
+//   -DSTACER_DISABLE_SVG_ANIMATION force a static frame on any Qt >= 6.8
+inline void configureLoaderSvg(QSvgRenderer *renderer)
+{
+#if QT_VERSION < QT_VERSION_CHECK(6, 8, 0)
+    // QSvgRenderer animation was introduced in Qt 6.8; nothing to configure.
+    Q_UNUSED(renderer);
+#elif defined(STACER_DISABLE_SVG_ANIMATION) || \
+    (QT_VERSION < QT_VERSION_CHECK(6, 9, 0) && !defined(STACER_ENABLE_SVG_ANIMATION))
+    renderer->setAnimationEnabled(false);
+#else
+    renderer->setFramesPerSecond(60);
+#endif
+}
+
+#endif // SVG_LOADER_COMPAT_H
